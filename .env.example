# Copy to .env (gitignored) for docker-compose.dev.yml and local runs.

# --- Environment -------------------------------------------------------------------------
# "prod" refuses the username/password fallback below; anything else allows it.
AUTOSENTRY_ENV=dev

# --- Graph Data MCP server (tigergraph-mcp, streamable HTTP) -----------------------------
# docker-compose.dev.yml points the agent at its own tigergraph-mcp service; for a local
# run, start one with: tigergraph-mcp --transport streamable-http --port 8010
GRAPH_DATA_MCP_URL=http://localhost:8010
GRAPH_DATA_MCP_TIMEOUT_SECONDS=60

# --- TigerGraph ----------------------------------------------------------------------------
# The workspace URL, e.g. https://tg-<id>.tg-<org>.i.tgcloud.io
TG_HOST=
TG_GRAPHNAME=AutosentrySandbox
# Optional: the workspace's TigerGraph version, passed to tigergraph-mcp as X-TG-Version.
TG_VERSION=
# Optional: only when calls go through a workspace tools-server proxy.
TG_GSQL_PREFIX=
TG_RESTPP_PREFIX=

# --- LLM gateway (any OpenAI-compatible endpoint) -------------------------------------------
# Default: Gemini through Google's OpenAI-compatible endpoint. For Groq use
# https://api.groq.com/openai/v1 with openai/gpt-oss-120b; for OpenAI, https://api.openai.com/v1.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# --- Knowledge search (graphrag) -------------------------------------------------------------
GRAPHRAG_BASE_URL=http://localhost:8000

# --- Credentials (secrets: real values only in .env or the secrets store) ---------------------
# The LLM provider's API key. Without it the agent starts, and /investigate answers 503.
LLM_API_KEY=
# A TigerGraph JWT, e.g. from POST {TG_HOST}/gsql/v1/tokens with the workspace secret.
TG_JWT_TOKEN=
# Dev-only fallback when TG_JWT_TOKEN is unset; refused when AUTOSENTRY_ENV=prod.
TG_USERNAME=
TG_PASSWORD=

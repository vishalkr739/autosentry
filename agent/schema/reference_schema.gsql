CREATE VERTEX Person (PRIMARY_ID person_id STRING, anonymized_ssn_hash STRING, kyc_verified_at DATETIME)
CREATE VERTEX Account (PRIMARY_ID account_id STRING, kyc_score FLOAT, open_date DATETIME, status STRING)
CREATE VERTEX Transaction (PRIMARY_ID tx_id STRING, amount FLOAT, timestamp DATETIME, channel STRING)
CREATE VERTEX Device (PRIMARY_ID device_id STRING, fingerprint STRING, first_seen_at DATETIME)
CREATE VERTEX IPAddress (PRIMARY_ID ip_address STRING, is_vpn BOOL, country_code STRING)
CREATE VERTEX Merchant (PRIMARY_ID merchant_id STRING, mcc STRING)
CREATE VERTEX Case (PRIMARY_ID case_id STRING, status STRING, opened_at DATETIME, closed_at DATETIME)
CREATE VERTEX Beneficiary (PRIMARY_ID beneficiary_id STRING, name_hash STRING, bank_identifier STRING)
CREATE VERTEX Card (PRIMARY_ID card_id STRING, last4_hash STRING, network STRING, status STRING)
CREATE VERTEX LoginEvent (PRIMARY_ID login_id STRING, timestamp DATETIME, outcome STRING)

CREATE UNDIRECTED EDGE OWNS (FROM Person, TO Account, since DATETIME)
CREATE DIRECTED EDGE INITIATED (FROM Account, TO Transaction) WITH REVERSE_EDGE="reverse_INITIATED"
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO Device) WITH REVERSE_EDGE="reverse_FROM_DEVICE"
CREATE DIRECTED EDGE FROM_IP (FROM Transaction, TO IPAddress) WITH REVERSE_EDGE="reverse_FROM_IP"
CREATE DIRECTED EDGE AT (FROM Transaction, TO Merchant) WITH REVERSE_EDGE="reverse_AT"
CREATE DIRECTED EDGE PAYS (FROM Transaction, TO Beneficiary) WITH REVERSE_EDGE="reverse_PAYS"
CREATE DIRECTED EDGE PAYS_TO_ACCOUNT (FROM Transaction, TO Account) WITH REVERSE_EDGE="reverse_PAYS_TO_ACCOUNT"
CREATE DIRECTED EDGE INVESTIGATED_IN (FROM Account, TO Case, role STRING) WITH REVERSE_EDGE="reverse_INVESTIGATED_IN"
CREATE DIRECTED EDGE HOLDS (FROM Account, TO Card, issued_at DATETIME) WITH REVERSE_EDGE="reverse_HOLDS"
CREATE DIRECTED EDGE VIA (FROM Transaction, TO Card) WITH REVERSE_EDGE="reverse_VIA"
CREATE DIRECTED EDGE LOGGED_IN (FROM Account, TO LoginEvent) WITH REVERSE_EDGE="reverse_LOGGED_IN"
CREATE DIRECTED EDGE LOGIN_FROM_DEVICE (FROM LoginEvent, TO Device) WITH REVERSE_EDGE="reverse_LOGIN_FROM_DEVICE"
CREATE DIRECTED EDGE LOGIN_FROM_IP (FROM LoginEvent, TO IPAddress) WITH REVERSE_EDGE="reverse_LOGIN_FROM_IP"

CREATE GRAPH AutosentrySandbox (
  Person, Account, Transaction, Device, IPAddress, Merchant, Case, Beneficiary, Card, LoginEvent,
  OWNS, INITIATED, FROM_DEVICE, FROM_IP, AT, PAYS, PAYS_TO_ACCOUNT, INVESTIGATED_IN, HOLDS, VIA,
  LOGGED_IN, LOGIN_FROM_DEVICE, LOGIN_FROM_IP
)
